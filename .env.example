# Copy to .env.local and fill in your MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fabric_production?retryWrites=true&w=majority"
MONGODB_DB="fabric_production"
NEXT_PUBLIC_APP_NAME="Fabric Plant — Production"

# Secret used to sign session cookies (any long random string). A dev fallback
# is used if unset, but set your own in real deployments.
AUTH_SECRET="change-me-to-a-long-random-string"
